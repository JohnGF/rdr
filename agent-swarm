  win_title="Agent Swarm (rdr)"
  win_class="agent-swarm,agent-swarm"

  if [[ "$CLEAR_SESSION" == "true" ]]; then
    extra_flags+=("--clear")
  fi
  if [[ "$LAYOUT_EXPLICIT" == "true" ]]; then
    extra_flags+=("--layout" "$LAYOUT_PRESET")
  fi
  case "$TERM_APP" in
  konsole)
    if [[ "$WIN_MODE" == "fullscreen" ]]; then
      exec env AGENT_SWARM_IN_TERM=1 konsole --fullscreen -p TerminalMargin=0 --hide-menubar --hide-tabbar -e "$0" -t "${extra_flags[@]}" "${REMAINING_ARGS[@]}"
    else
      exec env AGENT_SWARM_IN_TERM=1 konsole -p TerminalMargin=0 --hide-menubar --hide-tabbar --qwindowgeometry 2500x1400 -e "$0" -t "${extra_flags[@]}" "${REMAINING_ARGS[@]}"
    fi
    ;;
  alacritty | *)
    startup_opt="Maximized"
    if [[ "$WIN_MODE" == "fullscreen" ]]; then
      startup_opt="Fullscreen"
    elif [[ "$WIN_MODE" == "floating" ]]; then
      startup_opt="Windowed"
    fi
    exec env AGENT_SWARM_IN_TERM=1 alacritty -o "window.startup_mode=\"$startup_opt\"" -o "window.dynamic_title=true" --class "$win_class" -e "$0" -t "${extra_flags[@]}" "${REMAINING_ARGS[@]}"
    ;;
  esac
fi

# Determine project directories for session
