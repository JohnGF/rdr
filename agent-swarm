if [[ "${1:-}" == "restart-window" || "${1:-}" == "rw" ]]; then
  win="${2:-}"
  [[ -z "$win" ]] && { echo "Usage: agent-swarm restart-window <0|1|2|agents|editor|telemetry|N>"; exit 1; }

  if ! tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    # Allow overriding the target session for testing: SESSION_NAME=... agent-swarm rw 2
    echo "Swarm session '$SESSION_NAME' is not active." >&2
    exit 1
  fi
  # Resolve name -> index
  case "$win" in
  telemetry) win=0 ;;
  agents | agent | ai) win=1 ;;
  editor | edit | nvim) win=2 ;;
  *)
    idx=$(tmux list-windows -t "$SESSION_NAME" -F "#{window_index}:#{window_name}" |
      awk -F: -v w="$win" '$2==w{print $1; exit}')
    [[ -n "$idx" ]] && win="$idx"
    ;;
  esac

  if ! tmux list-windows -t "$SESSION_NAME" -F "#{window_index}" | grep -qx -- "$win"; then
    echo "No window '$win' in swarm '$SESSION_NAME'." >&2
    exit 1
  fi

  if [[ "$win" == "0" ]]; then
    echo "Window 0 is the telemetry cockpit; rebuild the whole swarm with 'rdr -r'." >&2
    exit 1
  fi

  target_dir=$(tmux display-message -t "$SESSION_NAME:$win" -p "#{pane_current_path}")
  [[ -d "$target_dir" ]] || target_dir="$HOME"
  shell_bin="$DEFAULT_SHELL"
  [[ "$win" == "1" ]] && shell_bin="$AGENT_SHELL"

  # Close extra panes, respawn the survivor in place (fresh shell + clean scrollback)
  mapfile -t panes < <(tmux list-panes -t "$SESSION_NAME:$win" -F "#{pane_index}")
  for ((i = ${#panes[@]} - 1; i >= 1; i--)); do
    tmux kill-pane -t "$SESSION_NAME:$win.${panes[$i]}" 2>/dev/null || true
  done
  tmux resize-pane -t "$SESSION_NAME:$win.0" -Z 2>/dev/null || true
  tmux respawn-pane -k -t "$SESSION_NAME:$win.0" -c "$target_dir" "$shell_bin"
  tmux clear-history -t "$SESSION_NAME:$win.0" 2>/dev/null || true
  tmux select-window -t "$SESSION_NAME:$win"

  # Window 1 gets its 4-pane agent grid back
  if [[ "$win" == "1" ]]; then
    tmux select-pane -t "$SESSION_NAME:1.0"
    (
      export AGENT_SWARM_AGENT_SHELL="$AGENT_SHELL"
      apply_layout quad
    ) >/dev/null 2>&1 || true
  fi

  sync_window_title 2>/dev/null || true
  tmux refresh-client -S 2>/dev/null || true
  echo "Window $win restarted in $target_dir."
  exit 0
fi

if [[ "${1:-}" == "help" ]]; then
