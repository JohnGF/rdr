# Parse CLI options
RUN_IN_CURRENT_TERM=false
CLEAR_SESSION=false
TERM_APP="$DEFAULT_TERM"
WIN_MODE="$DEFAULT_MODE"
LAYOUT_PRESET="$DEFAULT_LAYOUT"
LAYOUT_EXPLICIT=false
REMAINING_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
  --clear | -clear | -c | clear)
    CLEAR_SESSION=true
    shift
    ;;
  -t | --terminal)
    RUN_IN_CURRENT_TERM=true
    shift
    ;;
  -g | --gui)
    RUN_IN_CURRENT_TERM=false
    shift
    ;;
  --alacritty)
    TERM_APP="alacritty"
    shift
    ;;
  --konsole)
    TERM_APP="konsole"
    shift
    ;;
  --maximized)
    WIN_MODE="maximized"
    shift
    ;;
  --fullscreen)
    WIN_MODE="fullscreen"
    shift
    ;;
  --floating)
    WIN_MODE="floating"
    shift
    ;;
  --single | -1)
    LAYOUT_PRESET="single"
    LAYOUT_EXPLICIT=true
    shift
    ;;
  --dual | -2)
    LAYOUT_PRESET="dual"
    LAYOUT_EXPLICIT=true
    shift
    ;;
  --tri | -3)
    LAYOUT_PRESET="tri"
    LAYOUT_EXPLICIT=true
    shift
    ;;
  --quad | -4)
    LAYOUT_PRESET="quad"
    LAYOUT_EXPLICIT=true
    shift
    ;;
  -l | --layout)
    LAYOUT_PRESET="$2"
    LAYOUT_EXPLICIT=true
    shift 2
    ;;
  *)
    REMAINING_ARGS+=("$1")
    shift
    ;;
  esac
done

# Verify dependencies before spawning any GUI window.
preflight_check "$TERM_APP"

# If not running in terminal mode and not already inside launched terminal, spawn wrapper
if [[ "$RUN_IN_CURRENT_TERM" == "false" && -z "${AGENT_SWARM_IN_TERM:-}" ]]; then
