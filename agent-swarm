tmux set-option -g set-titles on
tmux set-option -as terminal-overrides ",xterm*:XT,alacritty*:XT"
tmux set-option -t "$SESSION_NAME" set-titles-string "#(agent-swarm window-title)"
tmux set-option -g set-titles-string "#(agent-swarm window-title)"

# Window status tabs:
# Inactive window: subtle grey/blue
tmux set-window-option -t "$SESSION_NAME" window-status-format " #I:#W "
# Active window: highlighted green/frost
tmux set-window-option -t "$SESSION_NAME" window-status-current-style "bold,bg=#4C566A,fg=#ECEFF4"
tmux set-window-option -t "$SESSION_NAME" window-status-current-format " #[fg=#A3BE8C]#I:#W#[default] "

# Single-key window switching (Alt + number)
for i in {0..9}; do
  tmux bind-key -n "M-$i" select-window -t "$i"
done

# Directional navigation: Shift+Arrows
tmux bind-key -n S-Left if-shell -F "#{||:#{pane_at_left},#{window_zoomed_flag}}" "previous-window" "select-pane -L"
tmux bind-key -n S-Right if-shell -F "#{||:#{pane_at_right},#{window_zoomed_flag}}" "next-window" "select-pane -R"
tmux bind-key -n S-Up if-shell -F "#{window_zoomed_flag}" "" "select-pane -U"
tmux bind-key -n S-Down if-shell -F "#{window_zoomed_flag}" "" "select-pane -D"

# Pane cycling shortcut (Alt + `)
tmux bind-key -n "M-\`" select-pane -t :.+

# Layout & Zoom controls:
# Alt+z: Toggle full-screen zoom on active pane
tmux bind-key -n M-z resize-pane -Z

# Alt+l: Cycle layout (Single -> Dual -> Tri -> Quad -> Single)
tmux bind-key -n M-l run-shell "agent-swarm layout cycle"

# Alt+= and Alt+r: Reset/equalize pane dimensions (fixes accidental mouse deformation)
tmux bind-key -n M-= run-shell "agent-swarm layout reset"
tmux bind-key -n M-r run-shell "agent-swarm layout reset"
tmux bind-key "&" confirm-before -p "Close window #I (#{window_name})? (y/n)" kill-window

# Intuitive pane splits (standard tmux % and ", plus | and -) preserving current directory:
tmux bind-key % split-window -h -c "#{pane_current_path}"
tmux bind-key '"' split-window -v -c "#{pane_current_path}"
tmux bind-key '|' split-window -h -c "#{pane_current_path}"
tmux bind-key - split-window -v -c "#{pane_current_path}"

# Advanced commands under Ctrl+b prefix:
# Ctrl+b d = detach (tmux stock default, intentionally left untouched)
# Ctrl+b x = close pane (tmux stock default, intentionally left untouched)
tmux bind-key a command-prompt -p "Add project folder to swarm:" "run-shell 'agent-swarm add \"%%%\"'"
tmux bind-key f run-shell "agent-swarm toggle-scope"
tmux bind-key -n M-t run-shell "agent-swarm toggle-window-tracked"
tmux bind-key n if-shell -F "#{==:#{@swarm_notifs},on}" \
  "set -t $SESSION_NAME @swarm_notifs off ; refresh-client -S ; display-message 'Desktop Notifications: OFF (Press Ctrl+b n to enable)'" \
  "set -t $SESSION_NAME @swarm_notifs on ; refresh-client -S ; display-message 'Desktop Notifications: ON (Press Ctrl+b n to mute)'"
# Prefix+m: toggle Active AI Model readout in the status bar
tmux bind-key m if-shell -F "#{==:#{@swarm_show_model},on}" \
  "set -t $SESSION_NAME @swarm_show_model off ; refresh-client -S ; display-message 'Active Model Status Bar: OFF'" \
  "set -t $SESSION_NAME @swarm_show_model on ; refresh-client -S ; display-message 'Active Model Status Bar: ON'"
# Prefix+h: cheat sheet popup (dismiss with any key)
tmux bind-key h display-popup -E -w 90% -h 90% -T " agent-swarm keys " "$KEYS_VIEWER"

# Setup Window 0: 5-pane Laya Telemetry Cockpit
setup_telemetry_window

# Setup Initial Windows:
# Window 1: 'agents' - 4-shell quad grid in FISH for parallel AI coding agents
# Window 2: 'editor' - clean single-pane shell in FISH for nvim or user commands
PRIMARY_DIR="${PROJECTS[0]}"
AGENTS_LAYOUT="quad"
if [[ "$LAYOUT_EXPLICIT" == "true" ]]; then
  AGENTS_LAYOUT="$LAYOUT_PRESET"
fi

create_project_window "$PRIMARY_DIR" "$AGENTS_LAYOUT" "agents" "$AGENT_SHELL"
create_project_window "$PRIMARY_DIR" "single" "editor" "$DEFAULT_SHELL"

# Setup any additional project windows requested (Window 3..N)
if [[ ${#PROJECTS[@]} -gt 1 ]]; then
  for proj in "${PROJECTS[@]:1}"; do
    create_project_window "$proj" "$LAYOUT_PRESET" "" "$DEFAULT_SHELL"
  done
fi

# Focus Window 0 (telemetry) and attach
tmux select-window -t "$SESSION_NAME:0"
exec tmux attach-session -t "$SESSION_NAME"
