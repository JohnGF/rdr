else
  for arg in "${REMAINING_ARGS[@]}"; do
    if [[ -d "$arg" ]]; then
      PROJECTS+=("$(cd "$arg" && pwd)")
    else
      echo "Warning: Directory not found: $arg"
    fi
  done
fi

if [[ ${#PROJECTS[@]} -eq 0 ]]; then
  PROJECTS+=("$DEFAULT_PROJ")
fi

