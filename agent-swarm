# Model status bar subcommand: shows last dispatched AI model (for Ctrl+b m toggle)
if [[ "${1:-}" == "active-model" ]]; then
  curl -sm 3 http://127.0.0.1:4000/history 2>/dev/null | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    recent = d.get('recent_calls', d if isinstance(d, list) else [])
    for call in (recent[-1:] if isinstance(recent, list) else []):
